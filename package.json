{
  "name": "mint",
  "private": true,
  "scripts": {

    "db:d": "pnpm --filter @repo/db run db:d",
    "db:p": "pnpm --filter @repo/db run db:p",
    "db:i": "pnpm --filter @repo/db run db:i",
    "db:s": "pnpm --filter @repo/db run db:s",
    "db:dpis": "pnpm --filter @repo/db run db:dpis",

    "emu:s": "pnpm --filter ws-tests run start",

    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.6.0",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
