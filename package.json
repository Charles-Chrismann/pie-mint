{
  "name": "mint",
  "private": true,
  "scripts": {

    "logs": "docker compose -f docker-compose.vps.yml logs -f",

    "db:d": "docker compose down db s3 s3-setup redis -v && docker compose up db s3 s3-setup redis -d",
    "db:p": "pnpm --filter @repo/db run db:p",
    "db:i": "pnpm --filter @repo/db run db:i",
    "db:s": "pnpm --filter @repo/db run db:s",
    "db:dpis": "pnpm --filter @repo/db run db:dpis",

    "ws:dev": "pnpm --filter mint-ws run dev",
    "ws:seed": "docker compose down redis -v && docker compose up redis -d && sleep 1 && pnpm --filter mint-ws run db:seed",
    "emu:s": "pnpm --filter ws-tests run start",

    "build": "turbo run build",
    "dev_": "turbo run dev",
    "dev": "turbo run dev --parallel --filter=mint-ws --filter=mint-admin",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.6.0",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
